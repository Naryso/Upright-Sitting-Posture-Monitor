<Window x:Class="Upright.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Upright Settings"
        Width="620"
        Height="610"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        Background="Transparent"
        Foreground="#101828"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#F2F4F7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#E4E7EC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputBox" TargetType="TextBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#101828" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#98A2B3" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="FooterButton" TargetType="Button">
            <Setter Property="Width" Value="126" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">
        <Border x:Name="SettingsShell"
                Margin="14"
                Background="White"
                BorderBrush="#B8C2CF"
                BorderThickness="1.2"
                CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect Color="#263238"
                                  BlurRadius="28"
                                  ShadowDepth="8"
                                  Opacity="0.18" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="82" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="76" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="28,14,22,12"
                      MouseLeftButtonDown="OnWindowDrag">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="SettingsTitleText"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Text="Settings" />
                        <TextBlock Margin="0,3,0,0"
                                   FontSize="14"
                                   Foreground="#667085"
                                   Text="Posture alert configuration" />
                    </StackPanel>
                    <Button x:Name="CloseHeaderButton"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource HeaderButton}"
                            Click="OnCancelClicked"
                            ToolTip="Close">
                        <Path Width="12"
                              Height="12"
                              Data="M 1,1 L 11,11 M 11,1 L 1,11"
                              Stroke="#101828"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Button>
                </Grid>

                <Border Grid.Row="1" Background="#D7DCE2" />

                <StackPanel Grid.Row="2" Margin="30,22,30,12">
                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Text="Dead zone" />
                    <TextBox x:Name="DeadZoneTextBox"
                             Margin="0,8,0,0"
                             Style="{StaticResource InputBox}"
                             AutomationProperties.Name="Dead zone" />
                    <TextBlock x:Name="DeadZoneRangeText"
                               Margin="0,7,0,0"
                               FontSize="13"
                               Foreground="#475467"
                               Text="Default: 0.03 · Range: 0.00–0.20" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="13"
                               Foreground="#667085"
                               Text="Lower values trigger posture warnings sooner." />

                    <TextBlock Margin="0,22,0,0"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Text="Alert delay (seconds)" />
                    <TextBox x:Name="WarningDelayTextBox"
                             Margin="0,8,0,0"
                             Style="{StaticResource InputBox}"
                             AutomationProperties.Name="Alert delay in seconds" />
                    <TextBlock x:Name="WarningDelayRangeText"
                               Margin="0,7,0,0"
                               FontSize="13"
                               Foreground="#475467"
                               Text="Default: 0 seconds · Range: 0–30 seconds" />
                    <TextBlock Margin="0,3,0,0"
                               FontSize="13"
                               Foreground="#667085"
                               Text="The red screen-edge alert waits this long after poor posture is confirmed." />

                    <Border Margin="0,22,0,0"
                            Padding="14,12"
                            Background="#F0F7FF"
                            BorderBrush="#CFE2FA"
                            BorderThickness="1"
                            CornerRadius="8">
                        <TextBlock x:Name="RestartNoticeText"
                                   FontSize="13"
                                   Foreground="#153B6B"
                                   TextWrapping="Wrap"
                                   Text="Changes are saved now and will be applied the next time Upright starts." />
                    </Border>

                    <TextBlock x:Name="ValidationText"
                               Margin="0,10,0,0"
                               FontSize="13"
                               Foreground="#C62828"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />
                </StackPanel>

                <Grid Grid.Row="3" Margin="30,10,30,18">
                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Orientation="Horizontal">
                        <Button x:Name="CancelButton"
                                Style="{StaticResource FooterButton}"
                                Background="White"
                                BorderBrush="#0866D9"
                                BorderThickness="1.5"
                                Foreground="#0866D9"
                                Click="OnCancelClicked"
                                Content="Cancel" />
                        <Button x:Name="SaveButton"
                                Style="{StaticResource FooterButton}"
                                Background="#0866D9"
                                BorderBrush="#0866D9"
                                BorderThickness="1.5"
                                Foreground="White"
                                Click="OnSaveClicked"
                                Content="Save" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
