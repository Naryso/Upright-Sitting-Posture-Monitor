<Window x:Class="Upright.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Upright! - Sitting Posture Monitor"
        Width="780"
        Height="500"
        MinWidth="780"
        MinHeight="500"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        Background="Transparent"
        Foreground="#101828"
        FontFamily="Segoe UI"
        Loaded="OnLoaded"
        Closing="OnClosing"
        Closed="OnClosed">
    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="56" />
            <Setter Property="Padding" Value="24,0" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.40" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#0866D9" />
            <Setter Property="BorderBrush" Value="#0866D9" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style x:Key="SecondaryButton"
               TargetType="Button"
               BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#0866D9" />
            <Setter Property="Foreground" Value="#0866D9" />
        </Style>

        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#101828" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ChromeBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChromeBorder" Property="Background" Value="#F2F4F7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChromeBorder" Property="Background" Value="#E4E7EC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">
        <Border Margin="14"
                Background="White"
                BorderBrush="#B8B8B8"
                BorderThickness="1.2"
                CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect Color="#263238"
                                  BlurRadius="28"
                                  ShadowDepth="8"
                                  Opacity="0.18" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="112" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="30,18,24,14"
                      Background="Transparent"
                      MouseLeftButtonDown="OnWindowDrag">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Width="172"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                        <Border x:Name="BrandWordmark"
                                Width="172"
                                Height="50"
                                HorizontalAlignment="Left">
                            <Border.Background>
                                <ImageBrush ImageSource="Assets/UprightWordmarkSource.png"
                                            Stretch="Fill"
                                            Viewbox="0.205,0.335,0.61,0.31"
                                            ViewboxUnits="RelativeToBoundingBox" />
                            </Border.Background>
                        </Border>
                        <TextBlock x:Name="BrandSubtitle"
                                   Margin="2,2,0,0"
                                   HorizontalAlignment="Left"
                                   FontSize="16"
                                   Foreground="#667085"
                                   Text="Posture Monitor" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                MouseLeftButtonDown="OnChromeMouseDown">
                        <Button x:Name="SettingsButton"
                                Width="84"
                                Margin="0,0,8,0"
                                Style="{StaticResource ChromeButton}"
                                IsEnabled="False"
                                Click="OnSettingsClicked"
                                ToolTip="Settings"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Content="Settings" />
                        <Button x:Name="MinimizeButton"
                                Style="{StaticResource ChromeButton}"
                                Click="OnMinimizeClicked"
                                ToolTip="Minimize"
                                Content="−" />
                        <Button x:Name="CloseButton"
                                Style="{StaticResource ChromeButton}"
                                Click="OnCloseWindowClicked"
                                ToolTip="Close"
                                Content="×" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Background="#D0D0D0" />

                <Grid Grid.Row="2" Margin="30,24,30,28">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="56" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Margin="0,0,0,10"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Text="Camera" />

                    <Border Grid.Row="1"
                            Height="52"
                            Padding="14,0"
                            Background="White"
                            BorderBrush="#A8A8A8"
                            BorderThickness="1"
                            CornerRadius="6">
                        <ComboBox x:Name="CameraComboBox"
                                  Padding="4,0"
                                  VerticalContentAlignment="Center"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  FontSize="16"
                                  Foreground="#101828"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  DropDownOpened="OnCameraDropDownOpened"
                                  SelectionChanged="OnCameraSelectionChanged" />
                    </Border>

                    <TextBlock Grid.Row="3"
                               Margin="0,0,0,10"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Text="Status" />

                    <Border x:Name="WorkingIndicator"
                            Grid.Row="4"
                            Height="58"
                            Padding="16,0"
                            Background="White"
                            BorderBrush="#D7DCE2"
                            BorderThickness="1"
                            CornerRadius="6"
                            Visibility="Visible">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot"
                                     Width="14"
                                     Height="14"
                                     Margin="0,0,16,0"
                                     Fill="#98A2B3" />
                            <TextBlock x:Name="StatusText"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       Foreground="#475467"
                                       Text="Tool inactive" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="26" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CalibrateButton"
                                Grid.Column="0"
                                IsEnabled="False"
                                Style="{StaticResource SecondaryButton}"
                                Click="OnCalibrateClicked"
                                Content="Calibrate" />
                        <Button x:Name="StartStopButton"
                                Grid.Column="2"
                                Style="{StaticResource PrimaryButton}"
                                Click="OnStartStopClicked"
                                Content="Start" />
                    </Grid>

                    <TextBlock Grid.Row="7"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="#667085"
                               Text="Use this app in good lighting. Avoid dim environments and reflections on your face." />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
